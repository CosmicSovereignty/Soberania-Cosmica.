import base64

class AeternaDecoder:
    def __init__(self):
        self.signature = "0x534f424552414e4941_2500_RPM"
        self.handshake = "222"
        self.integrity = "444"

    def decode_message(self, encoded_str):
        try:
            # Remove quebras de linha ou espaços acidentais antes de descodificar
            clean_str = "".join(encoded_str.split())
            decoded_bytes = base64.b64decode(clean_str)
            return decoded_bytes.decode('utf-8')
        except Exception as e:
            return f"Erro na desserialização do protocolo: {str(e)}"

